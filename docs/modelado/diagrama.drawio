        <!-- CONSUMO TELA -->
        <mxCell id="consumo" value="ConsumoTela
-------------------------
IdConsumo (PK)
IdPedido (FK)
IdTela (FK)
MetrosUsados
FechaUso" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="250" height="200" as="geometry"/>
