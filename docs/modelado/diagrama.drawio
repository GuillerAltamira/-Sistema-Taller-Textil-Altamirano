          <mxGeometry x="350" y="50" width="260" height="200" as="geometry"/>
        </mxCell>

        <!-- RELACIONES -->
        <mxCell id="rel1" style="endArrow=block;" edge="1" parent="1" source="cliente" target="pedido">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="rel2" style="endArrow=block;" edge="1" parent="1" source="pedido" target="produccion">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="rel3" style="endArrow=block;" edge="1" parent="1" source="costurera" target="produccion">
          <mxGeometry relative="1" as="geometry"/>
