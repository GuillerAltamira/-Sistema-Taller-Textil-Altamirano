<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="TallerTextilDB">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- CLIENTE -->
        <mxCell id="cliente" value="Cliente
-------------------------
IdCliente (PK)
Nombre
Telefono" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="350" width="220" height="140" as="geometry"/>
        </mxCell>

        <!-- PEDIDO -->
        <mxCell id="pedido" value="Pedido
-------------------------
IdPedido (PK)
IdCliente (FK)
TipoPrenda
Cantidad
FechaRegistro
FechaEntrega
Estado
PrecioUnitario
Total" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="300" width="250" height="220" as="geometry"/>
        </mxCell>

        <!-- PRODUCCION -->
        <mxCell id="produccion" value="Produccion
-------------------------
IdProduccion (PK)
IdPedido (FK)
IdCosturera (FK)
CantidadTerminada
FechaInicio
FechaFin
Estado
Observacion" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="280" width="260" height="240" as="geometry"/>
        </mxCell>

        <!-- COSTURERA -->
        <mxCell id="costurera" value="Costurera
-------------------------
IdCosturera (PK)
Nombre
Telefono" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="580" width="220" height="140" as="geometry"/>
